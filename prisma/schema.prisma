// Database design for the to-do app.
// After changing this file, run: npm run db:migrate
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Priority {
  high
  medium
  low
}

enum Repeat {
  daily
  weekly
  monthly
}

// userId on every table is the signed-in user's id from Supabase Auth.
// All queries in the app filter by it, so each person only sees their own data.

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz
  tasks     Task[]

  @@unique([userId, name])
}

model Task {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  title      String
  notes      String    @default("")
  priority   Priority  @default(medium)
  // Due date with no time = due by the end of that day.
  dueDate    DateTime? @db.Date
  // Optional "HH:MM" (24-hour). Only set when dueDate is set.
  dueTime    String?
  // null = doesn't repeat. A repeating task moves to its next date when completed.
  repeat     Repeat?
  done       Boolean   @default(false)
  doneAt     DateTime? @db.Timestamptz
  categoryId String?   @db.Uuid
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @updatedAt @db.Timestamptz

  subtasks    Subtask[]
  completions TaskCompletion[]

  @@index([userId, done])
  @@index([userId, dueDate])
}

model Subtask {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([taskId, position])
}

// One row each time a repeating task is completed (the old app's "history").
model TaskCompletion {
  id              String    @id @default(uuid()) @db.Uuid
  taskId          String    @db.Uuid
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completedOn     DateTime  @db.Date
  // What the task looked like just before it moved on, so the tick can be undone:
  // its old due date (null = it had none) and which steps were ticked.
  previousDueDate DateTime? @db.Date
  stepsDone       String[]  @default([]) @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz

  @@index([taskId, completedOn])
}

// The bin behind Settings → Recently deleted. Deleting a task really removes
// it (with its steps and history) from the tables above, so nothing else —
// lists, calendar, Chat, Claude through the MCP server — can ever see it.
// A copy of it is kept here instead, for up to 30 days, so it can be put back.
// id = the deleted task's own id, so it comes back with the same id.
model RecentlyDeleted {
  id        String   @id @db.Uuid
  userId    String   @db.Uuid
  // Everything needed to put it back: the DeletedTask shape in src/lib/tasks.ts.
  copy      Json
  // Set by the database clock when it's binned (the app can't choose it).
  deletedAt DateTime @default(now()) @db.Timestamptz

  @@index([userId, deletedAt])
}

// The Claude features, for counting each person's use (see src/lib/usage.ts).
enum ClaudeFeature {
  suggest_steps
  ask
  chat
  mcp_change // a change made by Claude through the MCP server (no Claude cost: counted, not priced)
  chat_photo // a chat message with a photo attached (Photo to schedule)
}

// One row each time someone uses a Claude feature, so the server can enforce
// each person's limits (per minute, per day, and money spent per day).
// Written when the request starts; the token counts and cost are filled in
// when Claude finishes (finishedAt set). Rows are never deleted by the app.
model ClaudeUsage {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  feature      ClaudeFeature
  startedAt    DateTime      @default(now()) @db.Timestamptz
  finishedAt   DateTime?     @db.Timestamptz
  inputTokens  Int           @default(0)
  outputTokens Int           @default(0)
  // What Claude charged for this request, in US dollars (an estimate if you
  // pressed Stop part-way, on the high side).
  costUsd      Float         @default(0)

  @@index([userId, startedAt])
}
